rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    /** Matches who can create/edit pending transactions (admin + maker). */
    function canManageAttachments() {
      return signedIn() && userRole() in ['admin', 'maker'];
    }

    match /transactions/{txId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if canManageAttachments()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if canManageAttachments();
    }
  }
}
