# Copy to .env.local and fill in values from your Firebase project settings.
# Do not wrap values in quotes or add trailing commas.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin (service account). Never expose as NEXT_PUBLIC_*.
# Private key: paste the full key and keep \n escaped as \\n on one line.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Compact KPI/chart amounts: lakhs ("N lakhs") or international (B/M/K).
# NEXT_PUBLIC_COMPACT_NUMBER_SCALE=lakhs
NEXT_PUBLIC_COMPACT_NUMBER_SCALE=lakhs

