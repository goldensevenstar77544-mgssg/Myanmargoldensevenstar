# Copy to .env.local and fill in values from your Firebase project settings.
# Most values: no quotes, no trailing commas.
# Exception: FIREBASE_ADMIN_PRIVATE_KEY must use double quotes (see below).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin (service account JSON). Never use NEXT_PUBLIC_*.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=

# Private key format (required for Users → Create user):
# - Keep the ENTIRE value on ONE line
# - Wrap in double quotes "
# - Replace every real newline with the two characters \n (backslash + n)
# - Include BEGIN/END lines
#
# Correct (.env.local / most hosts):
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n...\n-----END PRIVATE KEY-----\n"
#
# Wrong (will break create-user in production):
# FIREBASE_ADMIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
# MIIE...
# -----END PRIVATE KEY-----
# FIREBASE_ADMIN_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n'
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# MIIE...
# -----END PRIVATE KEY-----"
#
# Vercel / similar UI: paste the same double-quoted one-line value, or paste
# the key with real newlines if the host stores multiline secrets natively.
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_KEY_BODY\n-----END PRIVATE KEY-----\n"
